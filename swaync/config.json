{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-width": 380,
  "control-center-height": 620,
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 160,
  "notification-body-image-width": 260,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "relative-timestamps": true,
  "widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "notifications"
  ],
  "scripts": {
    "spotify-art-fix": {
      "exec": "bash ~/.config/swaync/fix_spotify_art.sh",
      "app-name": "Spotify",
      "summary": ".*",
      "body": ".*",
      "run-on": "receive"
    }
  },
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰤨",
          "type": "toggle",
          "active": true,
          "tooltip": "Wi-Fi",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "tooltip": "Bluetooth",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
          "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
        },
        {
          "label": "󰀝",
          "type": "toggle",
          "tooltip": "Airplane Mode",
          "command": "bash ~/.config/hypr/scripts/AirplaneMode.sh",
          "update-command": "sh -c 'rfkill list wifi | grep -q \"Soft blocked: yes\" && echo true || echo false'"
        },
        {
          "label": "󰝟",
          "type": "toggle",
          "tooltip": "Mute Audio",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && pactl set-sink-mute @DEFAULT_SINK@ 1 || pactl set-sink-mute @DEFAULT_SINK@ 0'",
          "update-command": "sh -c '[[ $(pactl get-sink-mute @DEFAULT_SINK@) == \"Mute: yes\" ]] && echo true || echo false'"
        },
        {
          "label": "󰛨",
          "type": "toggle",
          "tooltip": "Night Light",
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && hyprsunset -t 4000 & || killall hyprsunset'",
          "update-command": "sh -c 'pgrep -x hyprsunset > /dev/null && echo true || echo false'"
        },
        {
          "label": "󰹑",
          "tooltip": "Screenshot",
          "command": "bash ~/.config/hypr/scripts/screenshot.sh"
        },
        {
          "label": "󰌾",
          "tooltip": "Lock Screen",
          "command": "hyprlock"
        },
        {
          "label": "󰐥",
          "tooltip": "Power Off",
          "command": "systemctl poweroff"
        }
      ]
    },
    "mpris": {
      "label": "Media Player",
      "show-art": true,
      "show-title": true,
      "show-artist": true,
      "image-size": 96,
      "image-radius": 12
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠"
    }
  }
}